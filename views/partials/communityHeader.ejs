<div class="community-container">
  <section class="review-list" aria-labelledby="community-heading">
    <header class="community-intro">
      <h1 id="community-heading">Community Book Reviews</h1>
      <h2>Written by book lovers, for book lovers</h2>

      <img
        src="/images/book-pile.jpg"
        alt="A pile of books"
        class="community-image"
      >
      <p>
        New customer?
        <a href="/contact">Sign up</a> to share your own reviews and join the discussion!
      </p>
      <p>
        Our Community Book Reviews page is a space where readers can share their
        thoughts, opinions, and recommendations about books they have read.
        Visitors can explore reviews from other book lovers, discover new titles,
        and see different perspectives on popular and lesser-known stories.
        The page encourages respectful discussion and helps build a welcoming
        community for people who enjoy reading. Whether someone is looking for
        their next book or wants to share a favorite, the review community makes
        it easier to connect through literature.
      </p>
    </header>

    <section class="community-reviews" aria-labelledby="reviews-heading">
      <h2 id="reviews-heading">Reader Reviews</h2>
      <div class="reviews-container">
        <% communityReviews.forEach(review => { %>
        <article class="review-card">
          <img src="<%= review.image %>" alt="<%= review.book %>" />
          <div class="review-card-content">
            <h3><%= review.book %></h3>
            <p class="review-author"><strong>Reviewed by:</strong> <%= review.user %></p>
            <p><%= review.review %></p>
          </div>
        </article>
        <% }); %>
      </div>
    </section>
  </section>

  <aside class="sidebar2" aria-label="Community information">
    <h2>Learn more about us &amp; our community</h2>
    <a class="sidebar2-link" href="/contact">Get in touch</a>
    <h3>Community Guidelines</h3>
    <ul>
      <li>Be respectful and considerate of others' opinions.</li>
      <li>Keep discussions on-topic and relevant to the book being reviewed.</li>
      <li>Avoid personal attacks, offensive language, or discriminatory remarks.</li>
      <li>Provide constructive feedback and support fellow readers.</li>
      <li>Report any inappropriate content to the moderators.</li>
    </ul>
    <div class="sidebar2-feature">
      <h3>Your review could be featured here</h3>
      <p>Submit your book review through our contact form.</p>
      <a class="sidebar2-link" href="/contact">Submit a review</a>
    </div>
  </aside>
</div>
