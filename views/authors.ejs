<!DOCTYPE html> 
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SpellBound Books | Authors</title>
    <link rel="stylesheet" href="/css/spellbound_books.css" />
  </head>
  <body>
    <div class="container">
      <div class="catalog-header">
        <h2>Author Spotlight</h2>
        <p>
          Learn about the authors behind the books you love. Learn more about
          their lives, works, and inspirations.
        </p>
        <p>
          Or discover a new writer to fall in love with! View our large
          selection of books and authors.
        </p>
      </div>
      <%- include("partials/bookBannerAd") %>
      <div class="content">
         <aside class="sidebar">
          <h3>Categories</h3>
          <ul>
            <li><a href="#fiction">Fiction</a></li>
            <li><a href="#non-fiction">Non-Fiction</a></li>
            <li><a href="#mystery">Mystery</a></li>
            <li><a href="#poetry">Poetry</a></li>
          </ul>
        </aside>

        <main class="book-list">
          <section class="catalog-section bestselling-authors">
  <div class="catalog-section-heading">
    <h2>Bestselling Authors</h2>
    <p>Explore the reader-favorite authors in our collection.</p>
  </div>

  <div class="author-grid">
    <% offeredAuthors.slice(0, 4).forEach((author) => { %>
      <article class="author-card">
        <img
          src="/<%= author.image.replace(/^\/+/, '') %>"
          alt="Photo of <%= author.name %>"
          class="author-card_image"
        />

        <div class="author-card_content">
          <span class="author-spotlight-label">
            Author Spotlight
          </span>

          <h3 class="author-card_author">
            <%= author.name %>
          </h3>

          <p class="author-card_format">
            <%= author.description %>
          </p>
        </div>
      </article>
    <% }); %>
  </div>
</section>

          <section class="catalog-section">
            <div class="catalog-section-heading" id="fiction">
              <h1>Fiction</h1>
              <p>Discover the latest and greatest fiction authors.</p>
            </div>
            <div class="author-grid">
              <% offeredAuthors
              .filter((author) => author.genre === "Fiction")
              .forEach((author) => { %>
                <article class="author-card">
                  <img
                    src="/<%= author.image %>"
                    alt="Photo of <%= author.name %>"
                    class="author-card_image"
                  >

                  <div class="author-card_content">
                    <h2 class="author-card_title"><%= author.title %></h2>
                    <p class="author-card_author"><%= author.name %></p>
                    <p class="author-card_format"><%= author.description %></p>            
                  </div>
                </article>
              <% }) %>
            </div>

            <div class="catalog-section-heading" id="non-fiction">
              <h1>Non-Fiction</h1>
              <p>Discover the latest and greatest non-fiction authors.</p>
            </div>
            <div class="author-grid">
              <% offeredAuthors
              .filter((author) => author.genre === "Non-Fiction")
              .forEach((author) => { %>
                <article class="author-card">
                  <img
                    src="/<%= author.image %>"
                    alt="Photo of <%= author.name %>"
                    class="author-card_image"
                  >

                  <div class="author-card_content">
                    <h2 class="author-card_title"><%= author.title %></h2>
                    <p class="author-card_author"><%= author.name %></p>
                    <p class="author-card_format"><%= author.description %></p>            
                  </div>
                </article>
              <% }) %>
            </div>

            <div class="catalog-section-heading" id="mystery">
              <h1>Mystery</h1>
              <p>Discover the latest and greatest mystery authors.</p>
            </div>
            <div class="author-grid">
              <% offeredAuthors
              .filter((author) => author.genre === "Mystery")
              .forEach((author) => { %>
                <article class="author-card">
                  <img
                    src="/<%= author.image %>"
                    alt="Photo of <%= author.name %>"
                    class="author-card_image"
                  >

                  <div class="author-card_content">
                    <h2 class="author-card_title"><%= author.title %></h2>
                    <p class="author-card_author"><%= author.name %></p>
                    <p class="author-card_format"><%= author.description %></p>            
                  </div>
                </article>
              <% }) %>
            </div>
            
            <div class="catalog-section-heading" id="poetry">
              <h1>Poetry</h1>
              <p>Discover the latest and greatest poetry authors.</p>
            </div>
            <div class="author-grid">
              <% offeredAuthors
              .filter((author) => author.genre === "Poetry")
              .forEach((author) => { %>
                <article class="author-card">
                  <img
                    src="/<%= author.image %>"
                    alt="Photo of <%= author.name %>"
                    class="author-card_image"
                  >

                  <div class="author-card_content">
                    <h2 class="author-card_title"><%= author.title %></h2>
                    <p class="author-card_author"><%= author.name %></p>
                    <p class="author-card_format"><%= author.description %></p>            
                  </div>
                </article>
              <% }) %>
            </div>
            
            </div>
          </section>
        </main>
      </div>
    </div>
  </body>
</html>
