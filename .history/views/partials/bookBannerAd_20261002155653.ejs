 <div class="advertisementContainer bookpreview">
          <% offeredAdvertisements.forEach((advertisement) => { %>
            <article class="advertisement-card">
                  <img
                    src="/images/banners/money-book-graphic.png"
                    alt="Illustration of a brain made from money"
                    class="advertisement-card_graphic"
                  >

              <img
                src="/<%= advertisement.image %>"
                alt="Cover of <%= advertisement.title %>"
                class="advertisement-card_image"
              >

              <div class="advertisement-card_content">
                <h3 class="advertisement-card_title"><%= advertisement.title %></h3>
                <p class="advertisement-card_tagline"><%= advertisement.tagline %></p>
              </div>
                      <h4>BUY NOW</h4>

            </article>
          <% }); %>
        </div>